{
  "name": "fresheek-filters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "dev": "shopify app dev",
    "build": "shopify app build && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "@shopify/admin-graphql-api-utilities": "^2.2.0",
    "@shopify/app": "^3.58.2",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.0.0",
    "@shopify/react-form": "^2.7.3",
    "@shopify/shopify-api": "^14.0.1",
    "@shopify/shopify-app-react-router": "^2.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "isbot": "^5.2.0",
    "prisma": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.3",
    "@shopify/eslint-plugin": "^44.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
